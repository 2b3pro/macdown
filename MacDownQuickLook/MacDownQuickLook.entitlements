<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Read the user's MacDown rendering preferences (extension flags, style name). -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>com.2b3pro.macdown</string>
		<string>com.2b3pro.macdown-debug</string>
	</array>
	<!-- Read user-installed styles from ~/Library/Application Support/MacDown/Styles. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/MacDown/</string>
	</array>
</dict>
</plist>
